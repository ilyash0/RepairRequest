<Page x:Class="RepairRequest.Views.SparePartEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RepairRequest.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="SparePartEditPage">

    <Grid Margin="5"
          Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Width="32"
               Margin="5"
               Source="/Images/icon.png" />
        <TextBlock x:Name="textBlockTitle"
                   Text="{Binding SparePartName}"
                   Grid.Column="1"
                   Margin="5"
                   FontSize="32" />

        <WrapPanel Grid.Column="2"
                   Grid.Row="2">
            <Button Click="Save_Click"
                    Content="Сохранить" />
            <Button Click="Cancel_Click"
                    Content="Назад" />
        </WrapPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="10"
                      Grid.Row="1"
                      Grid.ColumnSpan="3"
                      Background="#F4E8D3">

            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="5">

                <StackPanel>
                    <TextBlock Text="Наименование" />
                    <TextBox  x:Name="txtName"
                              Text="{ Binding SparePartName }"
                              MaxLength="100"
                              Margin="0 0 0 10" />

                    <TextBlock Text="Тип компонента" />
                    <ComboBox Name="comboBoxSparePartType"
                              DisplayMemberPath="SparePartTypeName"
                              SelectedValuePath="SparePartTypeId"
                              SelectedValue="{ Binding SparePartTypeId }"
                              Margin="0 0 0 10" />

                    <TextBlock Text="Цена компонента в рублях" />
                    <TextBox  x:Name="txtSparePartCost"
                              Text="{ Binding SparePartCost }"
                              MaxLength="10"
                              Margin="0 0 0 10"
                              PreviewTextInput="DoubleValidationTextBox" />

                    <TextBlock Text="Количество на складе" />
                    <TextBox  x:Name="txtQuantity"
                              Text="{ Binding Quantity }"
                              MaxLength="10"
                              Margin="0 0 0 10"
                              PreviewTextInput="DoubleValidationTextBox" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
