<Page x:Class="RepairRequest.Views.SparePartListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RepairRequest.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="SparePartListPage">

    <Grid Margin="5"
          Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Width="32"
               Margin="5"
               Source="/Images/icon.png" />
        <TextBlock Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Text="Список компонентов на складе"
                   Margin="5"
                   FontSize="32" />

        <WrapPanel Grid.Column="2"
                   Grid.Row="2">
            <Button Click="Button_Click_1"
                    Content="Создать новый компонент" />
            <Button Click="Back_Click"
                    Content="Назад" />
        </WrapPanel>

        <ListBox Name="sparePartsList"
                 Margin="5"
                 Background="#F4E8D3"
                 HorizontalContentAlignment="Stretch"
                 Grid.Row="1"
                 Grid.ColumnSpan="3"
                 MouseDoubleClick="sparePartsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="18"
                                   TextWrapping="Wrap">
                        <Run Text="{Binding SparePartName}" />
                        </TextBlock>

                        <TextBlock Grid.Column="1"
                                   Margin="0 0 15 0"
                                   FontSize="18">
                            <Run Text="{Binding SparePartCost}" />
                            <Run Text="  ₽" />
                        </TextBlock>

                        <TextBlock Grid.Row="1">
                            <Run Text="Тип: " />
                            <Run Text="{Binding SparePartType.SparePartTypeName}" /><LineBreak />
                            <Run Text="Требуемое количество: " />
                            <Run Text="{Binding Quantity}" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
